# CONFIG
CONFIG_PATH_WINDOWS = .\configuration.xml
CONFIG_PATH_LINUX = ./configuration.xml

# MICROSERVICE_PYTHON_TEMPLATE
MICROSERVICE_PYTHON_TEMPLATE_SOURCE_CODE_PATH_WINDOWS = ..\microservice_python_template\src
MICROSERVICE_PYTHON_TEMPLATE_SOURCE_CODE_PATH_LINUX = ../microservice_python_template/src

# API_GATEWAY_MICROSERVICE_TEMPLATE
API_GATEWAY_MICROSERVICE_TEMPLATE_SOURCE_CODE_PATH_WINDOWS = ..\gui\src
API_GATEWAY_MICROSERVICE_TEMPLATE_SOURCE_CODE_PATH_LINUX = ../gui/src
API_GATEWAY_HTTP_SERVER_HOST = 0.0.0.0
API_GATEWAY_HTTP_SERVER_PORT =  8000
API_GATEWAY_ZMQ_SERVER_HOST = 0.0.0.0
API_GATEWAY_ZMQ_SERVER_PORT = 8003

# ZMQ_SERVER_MICROSERVICE_TEMPLATE
ZMQ_SERVER_MICROSERVICE_TEMPLATE_SOURCE_CODE_PATH_WINDOWS = ..\zmq_server_microservice_template\src
ZMQ_SERVER_MICROSERVICE_TEMPLATE_SOURCE_CODE_PATH_LINUX = ../zmq_server_microservice_template/src
ZMQ_SERVER_HOST = 0.0.0.0 
ZMQ_SERVER_PORT = 8003

# DISPLAY
ENABLE_IMSHOW=True
DISPLAY=:0

# JPEG
OUTPUT_DIR=/app/logs
SAVE_JEPG_FRAMES=True
JPEG_QUALITY=90
JEPG_NAME_PATTERN=frame_{idx}.jpg

# LOGGING
LOG_FILE_PATH=/app/logs/algorithm.log
VIDEO_LOG_FILE_PATH=/app/logs/video_manager.log

# VIDEOS MANAGER
VIDEO_SOURCE=/home/desktop-dqh6lmk/Documents/YairProj/videos for the openCV project/horses_video.mp4
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FRAME_RATE=30
VIDEO_SHM_PATH=/dev/shm/video_frames